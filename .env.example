# .env.example
#
# Purpose:
# Outlines the required environment variables for local and production runs.
#
# Dependencies:
# None
#
# Usage:
# Run: cp .env.example .env
#
# Notes:
# Fill in real keys before launching services.
#
# Future Improvements:
# - Automate keys verification checks

# General Configurations
ENV=development
DEBUG=true
PROJECT_NAME="Pinterest MCP Core API"
LOG_LEVEL=INFO

# Database Configs
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5432/pinterest_mcp_dev

# Caching & Queue Configs
REDIS_URL=redis://localhost:6379/0

# Vector Database Configs
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ML Model Directories
MODEL_CACHE_DIR=/app/models/cache
CLIP_MODEL_NAME=siglip-so400m-patch14-384

# Pinterest Dev Access
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=

# ============================================
# FUTURE IMPROVEMENTS
# ============================================
#
# 1. AWS KMS authentication key profiles
# 2. Dynamic DB port settings
#
# ============================================
